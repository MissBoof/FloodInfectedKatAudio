#include <Arduino.h>
#include <DFRobotDFPlayerMini.h>

HardwareSerial DFSerial(1);
DFRobotDFPlayerMini player;

void setup() {
  Serial.begin(115200);
  delay(2000);

  Serial.println("Starting DFPlayer no-ACK test...");

  // Confirmed from your Feather:
  // RX = GPIO 38
  // TX = GPIO 39
  DFSerial.begin(9600, SERIAL_8N1, 38, 39);

  delay(3000);

  // FALSE = don't require ACK from the DFPlayer
  if (!player.begin(DFSerial, false, true)) {
    Serial.println("Library initialization failed.");
  } else {
    Serial.println("Sending commands without ACK...");
  } 

  delay(1500);

  player.volume(25);
  delay(500);

  Serial.println("Commanding /mp3/0001.mp3...a");
  player.playMp3Folder(1);
}

void loop() {
}
